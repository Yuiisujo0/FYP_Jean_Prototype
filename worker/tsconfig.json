  "include": ["src", "../src/pipeline", "../src/lib/validate.ts", "../src/lib/flowGraph.ts", "../src/lib/engine.ts", "../src/lib/id.ts", "../src/data/nodeKinds.ts", "../src/types.ts"]
}
